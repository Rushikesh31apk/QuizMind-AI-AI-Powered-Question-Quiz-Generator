# ============================================================
# QuizMind AI - Environment Configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# Flask core
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-string

# ------------------------------------------------------------
# Database configuration
# ------------------------------------------------------------
# Easiest for local development / VS Code — no server required:
DATABASE_URL=sqlite:///quizmind.db

# To use MySQL instead, comment the line above and uncomment/edit below:
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/quizmind_ai

# ------------------------------------------------------------
# AI provider configuration
# ------------------------------------------------------------
# Supported values: "gemini", "openai", "demo"
# "demo" runs a fully offline template-based generator so the app
# works out of the box even without an API key.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# File upload settings
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------
# Quiz defaults
# ------------------------------------------------------------
DEFAULT_QUIZ_TIME_MINUTES=30
